rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /wp2next/{allPaths=**} {
      allow read, write: if true;
    }
    match /concurso-na-veia/{allPaths=**} {
      allow read, write: if true;
    }
    // Podcasts gerados pelo servidor (sem autenticação no server-side)
    match /podcasts/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
